---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TipJar from '../components/TipJar.astro';
import SidebarAffiliate from '../components/SidebarAffiliate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, category, source, sourceUrl, pubDate, updatedDate, heroImage, tipCta } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description || title} image={heroImage} />
		<style>
			article {
				background: var(--bg-primary);
				border: 2px solid var(--border-color);
				border-radius: var(--radius);
				overflow: hidden;
				box-shadow: none;
			}
			.hero-image {
				width: 100%;
				overflow: hidden;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: 100%;
				border-radius: 0;
				transition: transform 0.3s ease;
			}
			.hero-image:hover img {
				transform: scale(1.02);
			}
			.prose {
				padding: 2.5rem 3rem;
				color: var(--text-primary);
			}
			.title {
				margin-bottom: 2rem;
				text-align: left;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 1rem 0;
				font-size: 3rem;
				line-height: 1;
				font-family: 'Oswald', sans-serif;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}
			.meta-bar {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}
			.date {
				color: var(--text-muted);
				font-size: 0.875rem;
				font-family: 'Oswald', sans-serif;
				letter-spacing: 0.05em;
			}
			.article-header {
				padding: 2.5rem 3rem 1.5rem 3rem;
			}
			.sidebar {
				position: sticky;
				top: 2rem;
				height: fit-content;
			}
			.source-attribution {
				font-size: 1.25rem;
				margin-bottom: 1rem;
				color: var(--text-primary);
			}
			.source-attribution a {
				color: var(--text-primary);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 4px;
				transition: color 0.2s ease;
			}
			.source-attribution a:hover {
				color: #555;
			}
			.content-wrapper {
				display: grid;
				grid-template-columns: 1fr 300px;
				gap: 2rem;
				align-items: start;
			}
			@media (max-width: 960px) {
				.content-wrapper {
					grid-template-columns: 1fr;
				}
			}
			@media (max-width: 720px) {
				.article-header, .prose {
					padding: 1.5rem;
				}
				.title h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="content-wrapper">
				<article>
					<div class="article-header">
						<div class="meta-bar">
							{category && <span class="badge">{category}</span>}
							<span class="date"><FormattedDate date={pubDate} /></span>
						</div>
						<div class="title">
							<h1>{title}</h1>
						</div>
					</div>

					{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt={title} loading="eager" fetchpriority="high" />
					</div>
					)}

					<div class="prose">
						{sourceUrl && (
							<p class="source-attribution">The <em>{source || "Original Site"}</em> <a href={sourceUrl} target="_blank" rel="noopener noreferrer">reports</a>:</p>
						)}
						
						<slot />
						
						<TipJar tipCta={tipCta} />
					</div>
				</article>
				<aside class="sidebar">
					<SidebarAffiliate category={category} />
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>
