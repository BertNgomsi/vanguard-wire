---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const rawPosts = await getCollection('blog');
const posts = rawPosts.map((post) => {
	let preview = post.data.description;
	if (!preview && post.body) {
		preview = post.body.replace(/^#+.*$/gm, '').replace(/[*_>`\[\]]/g, '').trim().split('\n').filter(line => line.trim().length > 0)[0];
		if (preview && preview.length > 160) {
			preview = preview.substring(0, 160) + '...';
		}
	}
	return { ...post, preview };
}).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-tagline {
				margin-bottom: 1.5rem;
				border-bottom: 2px solid var(--border-color);
				padding-bottom: 1.5rem;
			}
			.hero-tagline h1 {
				font-size: 3.5rem;
				line-height: 1.4;
				margin-bottom: 0.5rem;
			}
			.highlight {
				background-color: var(--accent-yellow);
				color: #000;
				padding: 0 0.5rem;
				box-decoration-break: clone;
				-webkit-box-decoration-break: clone;
			}
			.hero-tagline p {
				font-size: 1.25rem;
				color: var(--text-secondary);
				max-width: 600px;
			}
			.feed {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.feed-item {
				background: var(--bg-primary);
				border: 2px solid var(--border-color);
				border-radius: var(--radius);
				padding: 1.25rem;
				transition: all 0.2s ease;
				position: relative;
			}
			.feed-item:hover {
				transform: translate(4px, -4px);
				box-shadow: -4px 4px 0 var(--accent-yellow);
				border-color: var(--accent-yellow);
			}
			.feed-item a {
				text-decoration: none;
				color: inherit;
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: 1rem;
			}
			.feed-content {
				flex: 1;
				min-width: 0;
			}
			.feed-thumbnail {
				width: 120px;
				height: 120px;
				flex-shrink: 0;
				border-radius: 4px;
				overflow: hidden;
			}
			.feed-thumbnail img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			@media (max-width: 640px) {
				.feed-item a {
					flex-direction: column-reverse;
					gap: 1rem;
				}
				.feed-thumbnail {
					width: 100%;
					height: 200px;
				}
			}
			.meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 0.75rem;
				font-size: 0.875rem;
			}
			.date {
				color: var(--text-muted);
				font-family: 'Oswald', sans-serif;
				letter-spacing: 0.05em;
			}
			.title {
				margin: 0 0 0.5rem 0;
				color: var(--text-primary);
				font-size: 1.75rem;
				line-height: 1.2;
				transition: color 0.2s ease;
			}
			.feed-item:hover .title {
				text-decoration: underline;
			}
			.description {
				color: var(--text-secondary);
				font-size: 1.05rem;
				line-height: 1.5;
				margin-bottom: 1rem;
			}
			.source {
				font-weight: 600;
				color: var(--text-secondary);
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-family: 'Oswald', sans-serif;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.source::before {
				content: "→";
				color: var(--accent-yellow);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-tagline">
				<h1><span class="highlight">UNCOMPROMISING</span><br />INQUIRY.</h1>
				<p>The definitive digital ledger for Black progressive politics, civil rights, and accountability.</p>
			</section>
			<section>
				<ul class="feed">
					{
						posts.map((post) => (
							<li class="feed-item">
								<a href={`/blog/${post.id}/`}>
									<div class="feed-content">
										<div class="meta">
											{post.data.category && <span class="badge">{post.data.category}</span>}
											<span class="date"><FormattedDate date={post.data.pubDate} /></span>
										</div>
										<h3 class="title">{post.data.title}</h3>
										{post.preview && <p class="description">{post.preview}</p>}
										{post.data.source && <div class="source">{post.data.source}</div>}
									</div>
									{post.data.heroImage && (
										<div class="feed-thumbnail">
											<Image src={post.data.heroImage} alt="" />
										</div>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
