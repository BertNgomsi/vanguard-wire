---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SidebarAffiliate from '../components/SidebarAffiliate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const rawPosts = await getCollection('blog');
const posts = rawPosts.map((post) => {
	let preview = post.data.description;
	if (!preview && post.body) {
		preview = post.body.replace(/^#+.*$/gm, '').replace(/[*_>`\[\]]/g, '').trim().split('\n').filter(line => line.trim().length > 0)[0];
	}
	
	// Conditionally handle "The" in the source name
	let sourcePrefix = 'The ';
	if (post.data.source && post.data.source.toLowerCase().startsWith('the ')) {
		sourcePrefix = '';
	}
	
	return { ...post, preview, sourcePrefix };
}).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-tagline {
				margin-bottom: 2rem;
				border-bottom: 2px solid var(--border-color);
				padding-bottom: 1.5rem;
				text-align: center;
			}
			.hero-tagline h1 {
				font-size: 3rem;
				line-height: 1.2;
				margin-bottom: 0.5rem;
				font-family: 'Oswald', sans-serif;
				text-transform: uppercase;
			}
			.highlight {
				background-color: var(--accent-yellow);
				color: #000;
				padding: 0 0.5rem;
			}
			.hero-tagline p {
				font-size: 1.2rem;
				color: var(--text-secondary);
				margin: 0 auto;
			}

			.content-wrapper {
				display: grid;
				grid-template-columns: 1fr 300px;
				gap: 3rem;
				align-items: start;
			}
			
			@media (max-width: 960px) {
				.content-wrapper { grid-template-columns: 1fr; }
			}
			
			/* New Feed Styles */
			.feed {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}
			.feed-item {
				padding-bottom: 2.5rem;
				border-bottom: 2px solid var(--border-color);
			}
			.feed-item:last-child {
				border-bottom: none;
			}
			
			.feed-title {
				font-family: 'Oswald', sans-serif;
				font-size: 2.5rem;
				font-weight: 700;
				line-height: 1.15;
				margin: 0 0 0.75rem 0;
				text-transform: uppercase;
			}
			.feed-title a {
				color: var(--text-primary);
				text-decoration: none;
				transition: color 0.2s;
			}
			.feed-title a:hover {
				color: #555;
			}
			
			.meta-bar {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 1rem;
				margin-bottom: 1rem;
			}
			
			.feed-image {
				width: 100%;
				margin-bottom: 1rem;
				overflow: hidden;
				display: block;
				aspect-ratio: 16 / 9;
				background-color: var(--border-color);
			}
			.feed-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.3s ease;
			}
			.feed-image:hover img {
				transform: scale(1.02);
			}
			
			.feed-excerpt {
				font-size: 1.15rem;
				line-height: 1.7;
				color: var(--text-primary);
				margin-bottom: 1rem;
				font-family: 'Inter', sans-serif;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			
			.source-attribution {
				font-weight: 500;
			}
			.source-attribution a {
				color: var(--text-primary);
				text-decoration: underline;
				text-underline-offset: 4px;
				text-decoration-thickness: 1px;
			}
			
			.btn-read-more {
				display: inline-block;
				background-color: var(--text-primary);
				color: #ffffff;
				font-family: 'Oswald', sans-serif;
				font-weight: 700;
				font-size: 1rem;
				text-transform: uppercase;
				padding: 0.4rem 1.25rem;
				text-decoration: none;
				transition: all 0.2s;
				box-shadow: 4px 4px 0px 0px rgba(0,0,0,0.1);
			}
			.btn-read-more:hover {
				transform: translateY(-2px);
				box-shadow: 4px 6px 0px 0px rgba(0,0,0,0.2);
			}
			
			.sidebar { position: sticky; top: 2rem; }
			
			@media (max-width: 720px) {
				.feed-title { font-size: 2rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-tagline">
				<h1><span class="highlight">UNCOMPROMISING</span> INQUIRY.</h1>
				<p>The definitive digital ledger for Black progressive politics, civil rights, and accountability.</p>
			</section>

			<div class="content-wrapper">
				<div class="feed-container">
					<ul class="feed">
						{
							posts.map((post) => (
								<li class="feed-item">
									<h2 class="feed-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
									<div class="meta-bar">
										{post.data.category && <span class="badge">{post.data.category}</span>}
										<span class="date"><FormattedDate date={post.data.pubDate} /></span>
									</div>
									
									{post.data.heroImage && !post.data.unsplashImage && (
										<a href={`/blog/${post.id}/`} class="feed-image">
											<Image width={1020} height={510} src={post.data.heroImage} alt={post.data.title} loading="lazy" />
										</a>
									)}

									{post.data.unsplashImage && (
										<a href={`/blog/${post.id}/`} class="feed-image">
											<img src={post.data.unsplashImage} alt={post.data.title} width="1020" height="510" loading="lazy" />
										</a>
									)}
									
									<div class="feed-excerpt">
										{post.data.source && post.data.sourceUrl && (
											<span class="source-attribution">{post.sourcePrefix}<em>{post.data.source}</em> <a href={post.data.sourceUrl} target="_blank" rel="noopener noreferrer">reports</a>: </span>
										)}
										{post.preview}
									</div>
									
									<a href={`/blog/${post.id}/`} class="btn-read-more">Read More &raquo;</a>
								</li>
							))
						}
					</ul>
				</div>
				
				<aside class="sidebar">
					<SidebarAffiliate />
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>
