---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="solid">
	<nav>
		<div class="logo">
			<span class="vw-box">VW</span>
			<h2><a href="/">{SITE_TITLE}</a></h2>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Wire Feed</HeaderLink>
			<HeaderLink href="/category/civil-rights">Civil Rights</HeaderLink>
			<HeaderLink href="/category/extremism">Extremism</HeaderLink>
			<HeaderLink href="/category/accountability">Accountability</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #000000;
		border-bottom: 4px solid var(--accent-yellow);
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.vw-box {
		background: var(--accent-yellow);
		color: #000;
		padding: 0.15rem 0.35rem;
		font-family: 'Oswald', sans-serif;
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1;
	}
	h2 {
		margin: 0;
		font-size: 1.5em;
		letter-spacing: -0.05em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #ffffff;
	}
	h2 a:hover {
		color: var(--accent-yellow);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		height: 70px;
	}
	nav a {
		padding: 1em 0.5em;
		color: #a1a1aa;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-family: 'Oswald', sans-serif;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 1.1rem;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent-yellow);
		color: var(--accent-yellow);
	}
	nav a:hover {
		color: #ffffff;
	}
	.internal-links {
		display: flex;
		gap: 1.5rem;
	}
</style>
