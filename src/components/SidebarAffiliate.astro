---
interface Props {
  category?: string;
}
const { category = "default" } = Astro.props;

type Affiliate = {
  name: string;
  image: string;
  text: string;
  link: string;
};

// Basic JSON mapping logic for affiliates
const affiliates: Record<string, Affiliate> = {
  "Cybersecurity": {
    name: "NordVPN",
    image: "/nordvpn-banner.jpg", // Placeholder
    text: "THE GLOBAL ELITE IS GAINING CONTROL. ENCRYPT YOUR LIFE. DEFEND YOUR DIGITAL FREEDOM BEFORE IT'S TOO LATE.",
    link: "#" // Will be replaced with user's affiliate link
  },
  "default": {
    name: "Progressive Bookshop",
    image: "/bookshop-banner.jpg",
    text: "SUPPORT INDEPENDENT JOURNALISM AND LOCAL BOOKSTORES. ARM YOURSELF WITH KNOWLEDGE.",
    link: "#"
  }
};

const affiliate = affiliates[category] || affiliates["default"];
---
<div class="affiliate-widget">
  <div class="widget-header">VANGUARD RECOMMENDS</div>
  <div class="widget-body">
    <!-- Placeholder image block since we don't have images yet -->
    <div class="image-placeholder">
       {affiliate.name}
    </div>
    <p class="widget-text">{affiliate.text}</p>
    <a href={affiliate.link} class="btn-affiliate" data-posthog="sidebar-affiliate">GET IT NOW</a>
  </div>
</div>

<style>
  .affiliate-widget {
    border: 4px solid var(--text-primary);
    background-color: var(--bg-primary);
    box-shadow: 6px 6px 0px 0px var(--text-primary);
    margin-bottom: 2rem;
    position: sticky;
    top: 2rem;
  }
  .widget-header {
    background-color: var(--text-primary);
    color: var(--bg-primary);
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    text-transform: uppercase;
    text-align: center;
    padding: 0.5rem;
    letter-spacing: 0.05em;
  }
  .widget-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .image-placeholder {
    width: 100%;
    height: 150px;
    background-color: var(--text-primary);
    color: var(--bg-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    text-transform: uppercase;
    text-align: center;
    padding: 1rem;
  }
  .widget-text {
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.3;
  }
  .btn-affiliate {
    display: block;
    width: 100%;
    text-align: center;
    background-color: var(--accent-yellow);
    color: var(--text-primary);
    border: 3px solid var(--text-primary);
    padding: 0.75rem 1rem;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.2s ease;
    box-shadow: 4px 4px 0px 0px var(--text-primary);
  }
  .btn-affiliate:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px 0px var(--text-primary);
  }
  .btn-affiliate:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px 0px var(--text-primary);
  }
</style>
